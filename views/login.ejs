<!DOCTYPE html>
<html>
  <head>
    <title>Login</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body>
    <%- include('navbar', { user }) %>
    <div class="container py-5">
      <div class="card shadow-sm rounded-4 p-4 p-md-5 auth-card">
        <h1 class="fw-bold mb-4 text-center text-brand-dark">🔐 Login</h1>
        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-danger rounded-4"><%= error %></div>
        <% } %>
        <form action="/login" method="POST">
          <div class="mb-3">
            <input type="email" class="form-control rounded-4" name="email" placeholder="Email" required />
          </div>
          <div class="mb-3">
            <input type="password" class="form-control rounded-4" name="password" placeholder="Password" required />
          </div>
          <button type="submit" class="btn btn-warning w-100 fw-bold rounded-pill py-2">Login</button>
        </form>
        <p class="text-center mt-3 mb-0">Don't have an account? <a href="/register" class="fw-bold">Register here</a>.</p>
      </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
