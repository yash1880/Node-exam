<!DOCTYPE html>
<html>
  <head>
    <title>Register</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body>
    <%- include('navbar', { user }) %>
    <div class="container py-5">
      <div class="card shadow-sm border-0 rounded-4 p-4 p-md-5 auth-card">
        <h1 class="fw-bold mb-4 text-center text-brand-dark">📝 Register</h1>
        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-danger rounded-4"><%= error %></div>
        <% } %>
        <form action="/register" method="POST">
          <div class="mb-3">
            <input type="text" class="form-control rounded-4" name="username" placeholder="Username" required />
          </div>
          <div class="mb-3">
            <input type="email" class="form-control rounded-4" name="email" placeholder="Email" required />
          </div>
          <div class="mb-3">
            <input type="password" class="form-control rounded-4" name="password" placeholder="Password" required />
          </div>
          <button type="submit" class="btn btn-warning w-100 fw-bold rounded-pill py-2">Register</button>
        </form>
        <p class="text-center mt-3 mb-0">Already have an account? <a href="/login" class="fw-bold">Login here</a>.</p>
      </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
