<div class="card h-100 shadow-sm border-0 rounded overflow-hidden">
  <% if (recipe.imageUrl) { %>
    <a href="/recipe/<%= recipe._id %>">
      <img src="<%= recipe.imageUrl %>" class="card-img-top recipe-card-img" alt="<%= recipe.title %>" />
    </a>
  <% } else { %>
    <a href="/recipe/<%= recipe._id %>">
      <div class="card-img-top recipe-card-img recipe-card-img-placeholder d-flex align-items-center justify-content-center">
        <span style="font-size: 3rem;">🍽️</span>
      </div>
    </a>
  <% } %>
  <div class="card-body d-flex flex-column">
    <div class="d-flex justify-content-between align-items-start mb-1">
      <h5 class="card-title fw-bold mb-0"><%= recipe.title %></h5>
      <span class="badge rounded-pill bg-warning text-dark ms-2"><%= recipe.category %></span>
    </div>
    <% if (recipe.createdBy) { %>
      <small class="text-muted mb-2">By <%= recipe.createdBy.username || 'Unknown' %></small>
    <% } %>
    <p class="card-text flex-grow-1"><%= recipe.description.split(' ').length > 12 ? recipe.description.split(' ').slice(0, 12).join(' ') + '...' : recipe.description %></p>
    <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top">
      <div class="btn-group btn-group-sm">
        <a class="btn btn-outline-primary" href="/recipe/edit/<%= recipe._id %>">✏️ Edit</a>
        <a class="btn btn-outline-danger" href="/recipe/delete/<%= recipe._id %>" onclick="return confirm('Delete this recipe?')">🗑️ Delete</a>
      </div>
      <a class="btn btn-sm btn-warning fw-bold" href="/recipe/<%= recipe._id %>">View →</a>
    </div>
  </div>
</div>

