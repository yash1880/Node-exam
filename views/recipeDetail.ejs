<!DOCTYPE html>
<html>
  <head>
    <title><%= recipe.title %> • Recipe Kitchen</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body>
    <%- include('navbar', { user }) %>
    <div class="container py-4">
      <div class="card shadow-sm rounded-4 p-4 p-md-5 content-card">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
          <div>
            <h1 class="fw-bold detail-header-title"><%= recipe.title %></h1>
            <p class="detail-meta">Category: <strong><%= recipe.category %></strong> • Created by: <%= recipe.createdBy?.username || 'Unknown' %></p>
          </div>
          <div class="d-flex gap-2 flex-wrap">
            <% if (recipe.isOwner) { %>
              <a class="btn btn-outline-primary rounded-pill" href="/recipe/edit/<%= recipe._id %>">✏️ Edit</a>
              <a class="btn btn-outline-danger rounded-pill" href="/recipe/delete/<%= recipe._id %>" onclick="return confirm('Delete this recipe?')">🗑️ Delete</a>
            <% } %>
            <a class="btn btn-back rounded-pill" href="/recipes">← Back</a>
          </div>
        </div>

        <% if (recipe.imageUrl) { %>
          <div class="detail-image mb-4" style="background-image: url('<%= recipe.imageUrl %>');"></div>
        <% } else { %>
          <div class="detail-image detail-image-placeholder mb-4">
            <div class="d-flex align-items-center justify-content-center h-100">
              <span style="font-size: 4rem;">🍽️</span>
            </div>
         </div>
        <% } %>

        <div class="mt-2">
          <div class="section-block">
            <h5 class="section-title">📖 Overview</h5>
            <p class="mb-0"><%= recipe.description %></p>
          </div>
          <div class="section-block">
            <h5 class="section-title">🥘 Ingredients</h5>
            <ul class="mb-0">
              <% recipe.ingredients.forEach(item => { %>
                <li><%= item %></li>
              <% }) %>
            </ul>
          </div>
          <div class="section-block">
            <h5 class="section-title">👨‍🍳 Instructions</h5>
            <ol class="mb-0">
              <% recipe.instructions.forEach(item => { %>
                <li><%= item %></li>
              <% }) %>
            </ol>
          </div>
        </div>
      </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
