<!DOCTYPE html>
<html>
  <head>
    <title><%= mode === 'edit' ? 'Edit Recipe' : 'New Recipe' %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body>
    <%- include('navbar', { user }) %>
    <div class="container py-4">
      <div class="card shadow-sm rounded-4 p-4 p-md-5 form-card">
        <h1 class="fw-bold mb-4 text-brand-dark"><%= mode === 'edit' ? '✏️ Edit Recipe' : '📝 Share a New Recipe' %></h1>
        <form action="/recipe/<%= mode === 'edit' ? 'edit/' + recipe._id : 'add' %>" method="POST">
          <div class="mb-3">
            <input type="text" class="form-control rounded-4" name="title" placeholder="Recipe title" value="<%= recipe.title || '' %>" required />
          </div>
          <div class="mb-3">
            <input type="url" class="form-control rounded-4" name="imageUrl" placeholder="Image URL (optional)" value="<%= recipe.imageUrl || '' %>" />
          </div>
          <div class="mb-3">
            <textarea class="form-control rounded-4" name="description" placeholder="Description" rows="3" required><%= recipe.description || '' %></textarea>
          </div>
          <div class="mb-3">
            <textarea class="form-control rounded-4" name="ingredients" placeholder="Ingredients (comma separated)" rows="3" required><%= recipe.ingredients ? recipe.ingredients.join(', ') : '' %></textarea>
          </div>
          <div class="mb-3">
            <textarea class="form-control rounded-4" name="instructions" placeholder="Instructions (comma separated)" rows="3" required><%= recipe.instructions ? recipe.instructions.join(', ') : '' %></textarea>
          </div>
          <div class="mb-4">
            <input type="text" class="form-control rounded-4" name="category" placeholder="Category" value="<%= recipe.category || '' %>" />
          </div>
          <div class="d-flex gap-3">
            <button type="submit" class="btn btn-warning fw-bold rounded-pill px-4"><%= mode === 'edit' ? 'Update Recipe' : 'Save Recipe' %></button>
            <% if (mode === 'edit') { %>
              <a class="btn btn-outline-secondary rounded-pill px-4" href="/recipe/<%= recipe._id %>">Cancel</a>
            <% } %>
          </div>
        </form>
      </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
