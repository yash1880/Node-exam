<!DOCTYPE html>
<html>
  <head>
    <title>My Recipes</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body>
    <%- include('navbar', { user }) %>
    <div class="container py-4">
      <h1 class="text-center fw-bold mb-4 page-heading">My Recipes</h1>
      <div class="row g-4">
        <% recipes.forEach(recipe => { %>
          <div class="col-12 col-sm-6 col-lg-4">
            <%- include('recipeItem', { recipe, user }) %>
          </div>
        <% }) %>
        <% if (recipes.length === 0) { %>
          <div class="col-12 text-center py-5 empty-state">
            <p class="fs-5">No recipes yet. <a href="/recipe/add" class="fw-bold">Create your first recipe!</a></p>
          </div>
        <% } %>
      </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
